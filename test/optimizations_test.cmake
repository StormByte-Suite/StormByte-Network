cmake_minimum_required(VERSION 3.28)

function(assert_equal name expected)
	if(NOT "${${name}}" STREQUAL "${expected}")
		message(FATAL_ERROR "${name}: expected '${expected}', got '${${name}}'")
	endif()
endfunction()

function(assert_lto expected)
	foreach(suffix "" _DEBUG _RELEASE _RELWITHDEBINFO _MINSIZEREL)
		assert_equal("CMAKE_INTERPROCEDURAL_OPTIMIZATION${suffix}" "${expected}")
	endforeach()
endfunction()

set(ENV{CFLAGS} "")
set(ENV{CXXFLAGS} "")
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_BUILD_TYPE Release)
set(CMAKE_C_FLAGS "")
set(CMAKE_CXX_FLAGS "")
set(CMAKE_C_FLAGS_INIT "")
set(CMAKE_CXX_FLAGS_INIT "")
set(CMAKE_C_FLAGS_RELEASE_INIT "-O3 -DNDEBUG")
set(CMAKE_CXX_FLAGS_RELEASE_INIT "-O3 -DNDEBUG")
set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
unset(ENABLE_LTO)
unset(ENABLE_LTO CACHE)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/optimizations.cmake")
assert_lto(ON)

foreach(generator single multi)
	if(generator STREQUAL "single")
		set(CMAKE_BUILD_TYPE Release)
		set(CMAKE_CONFIGURATION_TYPES "")
	else()
		set(CMAKE_BUILD_TYPE "")
		set(CMAKE_CONFIGURATION_TYPES "Debug;Release")
	endif()
	foreach(arch aarch64 x86_64)
		set(CMAKE_SYSTEM_PROCESSOR "${arch}")
		foreach(lto OFF ON)
			set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
			set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
			set(ENABLE_LTO "${lto}" CACHE BOOL "" FORCE)
			include("${CMAKE_CURRENT_LIST_DIR}/../cmake/optimizations.cmake")

			assert_equal(CMAKE_C_FLAGS "")
			assert_equal(CMAKE_CXX_FLAGS "")
			assert_equal(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG")
			assert_equal(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG")
			assert_lto("${lto}")
		endforeach()
	endforeach()
endforeach()

set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_BUILD_TYPE Release)
set(CMAKE_CONFIGURATION_TYPES "")
set(CMAKE_CXX_FLAGS "-stdlib=libc++")
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++")
set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG" CACHE STRING "" FORCE)
set(ENV{CXXFLAGS} "-stdlib=libc++")
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/optimizations.cmake")
assert_equal(CMAKE_CXX_FLAGS "-stdlib=libc++")
assert_equal(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG")
assert_equal(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG")

set(CMAKE_C_FLAGS "-march=armv8.2-a")
set(CMAKE_CXX_FLAGS "-stdlib=libc++ -march=armv8.2-a")
set(CMAKE_C_FLAGS_RELEASE "-O2 -DNDEBUG" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG" CACHE STRING "" FORCE)
set(ENABLE_LTO OFF CACHE BOOL "" FORCE)
set(ENV{CFLAGS} "-march=armv8.2-a")
set(ENV{CXXFLAGS} "-stdlib=libc++ -march=armv8.2-a")
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/optimizations.cmake")
assert_equal(CMAKE_C_FLAGS "-march=armv8.2-a")
assert_equal(CMAKE_CXX_FLAGS "-stdlib=libc++ -march=armv8.2-a")
assert_equal(CMAKE_C_FLAGS_RELEASE "-O2 -DNDEBUG")
assert_equal(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG")
assert_lto(OFF)
if(NOT "$ENV{CFLAGS}" STREQUAL "-march=armv8.2-a"
		OR NOT "$ENV{CXXFLAGS}" STREQUAL "-stdlib=libc++ -march=armv8.2-a")
	message(FATAL_ERROR "The supplied environment flags were modified")
endif()
